{
  "_comment": "Paths are relative to demo/; entries with * are glob patterns. Which branches agents may commit to and push is set in config/autoresearch.toml (git.branch_prefix). read_deny: never read (answers, human notes, raw data, the locked test set). write_deny: never modified by an agent (the referee, the rules, the data, the configs). bash_deny_tokens: a bash command containing any of these is blocked (demo-grade guard, not a security boundary).",
  "read_deny": [
    "../dataset",
    "../slides",
    "../plan",
    "config/secrets.env",
    ".pi-agent",
    ".tools",
    "checks/split.py",
    "checks/final_test.py",
    "~/.d3a-demo-private"
  ],
  "write_deny": [
    "checks", "hooks", "data", "skills", "TASK.md", "program.md", "AGENTS.md", "CLAUDE.md", "README.md",
    "train.py", "pyproject.toml", "uv.lock", "config", "scripts", "reports", ".claude", ".codex", ".pi", ".pi-agent",
    ".agents", "results/*/results.tsv", "results/*/champion.json", "results/*/session*.json", "results/*/hooks.log",
    "results/*/*/metrics.json", "results/*/*/pointwise.csv", "results/*/feedback*", "results/*/wandb*"
  ],
  "bash_deny_tokens": [
    "DATASET.md", "dataset/", "slides/", "plan/", ":(top)", "cip_features",
    "liverpool_ecoli", "build_cip_table", "secrets.env", "API_KEY", "GITHUB_TOKEN", "printenv", "environ",
    ".pi-agent", ".tools/", "/proc/", "vllm.sh", "vllm serve", "run_pi.sh", "run_codex.sh", "D3A_",
    "split.py", "final_test.py", ".d3a-demo-private",
    "--no-verify", "git push --force", "git push -f", "--force-with-lease", "git reset --hard",
    "git clean", "rm -rf", "git rebase", "git filter-branch", "git config", "chmod "
  ]
}
