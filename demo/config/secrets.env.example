# Copy to config/secrets.env (gitignored; scripts/setup.sh does this). One KEY=value per line, no spaces.
# Check what is set and working with:  uv run python scripts/check.py
# The agent cannot read this file (hooks); run_pi.sh passes only the model keys to pi.

# GitHub, for pull requests (skills/github-workflow/scripts/publish.py). They open in the repository of
# config/autoresearch.toml [git] repository; by default the one you cloned (your fork), never the one it was forked from.
# Create a fine-grained token at https://github.com/settings/personal-access-tokens/new
#   Resource owner: that repository's owner;  Repository access: only select repositories -> that repository
#   Permissions: Contents = Read-only (GitHub needs it to read the branches of a PR),
#                Pull requests = Read and write, Issues = Read and write (labels; optional, and forks have
#                Issues switched off until you enable them under Settings > General > Features)
# Pushing uses your SSH key, so Contents does not need write access.
GITHUB_TOKEN=

# Optional: models from OpenAI or DeepSeek instead of Qwen on dide2 (set [agent] model in config/endpoint.toml,
# or bash scripts/run_pi.sh --model openai/<model>). Everything the agent reads is sent to that provider.
#   https://platform.openai.com/api-keys
OPENAI_API_KEY=
#   https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional: Weights & Biases, to audit runs and agent trajectories ([tracking] in config/autoresearch.toml).
#   https://wandb.ai/authorize
WANDB_API_KEY=
